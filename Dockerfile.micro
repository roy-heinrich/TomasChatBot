# Micro Dockerfile for Railway - absolute minimum
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install only essential system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy micro requirements first
COPY requirements_micro.txt .

# Install Python dependencies with aggressive caching
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --timeout=3000 --retries=15 -r requirements_micro.txt

# Copy only essential application files
COPY app.py .
COPY start.py .
COPY chatbot_refactored.py .
COPY core/ ./core/
COPY multilingual_nlp.py .

# Set environment variables
ENV PYTHONPATH=/app
ENV NLTK_DATA=/app/nltk_data
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8080

# Start command
CMD ["python", "start.py"]
